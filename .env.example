# =============================================================================
# .env.example — Environment variable template for MailPilot
# =============================================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env, credentials.json, or token_*.json to git.
#            Add them to .gitignore before your first commit.
# =============================================================================

# --- Telegram -----------------------------------------------------------------
# Obtain from @BotFather on Telegram: send /newbot and follow the prompts.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Anthropic / Claude -------------------------------------------------------
# Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Gmail API ----------------------------------------------------------------
# Path to credentials.json downloaded from Google Cloud Console.
# See README.md → "Obtain Gmail API credentials" for step-by-step instructions.
GMAIL_CREDENTIALS_FILE=credentials.json

# Directory where per-user OAuth2 token files are stored.
# Each user gets a file named token_<telegram_id>.json in this directory.
# Default: project root (current directory).
GMAIL_TOKEN_DIR=tokens

# --- Database -----------------------------------------------------------------
# Path to the SQLite database file.
# The file is created automatically on first bot startup if it does not exist.
DATABASE_PATH=mailpilot.db

# --- Digest Schedule ----------------------------------------------------------
# Default digest time in UTC (HH:MM format).
# Individual users can override this value during the /setup wizard.
DIGEST_TIME=09:00

# --- Logging ------------------------------------------------------------------
# Application log level. Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended: DEBUG during development, INFO in production.
LOG_LEVEL=INFO

# --- Supabase -----------------------------------------------------------------
# Obtain from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_DB_PASSWORD=your_database_password_here